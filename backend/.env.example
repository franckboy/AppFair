PORT=3000

# Requerida para que la API no quede abierta a cualquiera. Genera una con,
# por ejemplo: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Si no la defines, el servidor genera una temporal en cada arranque y la
# imprime en consola (solo para desarrollo local).
API_KEY=

# Dominio(s) desde los que se permite llamar a esta API (separados por coma si son varios),
# ej. https://tuusuario.github.io. Si no la defines, CORS queda abierto a cualquier origen —
# aceptable en desarrollo local, pero restríngela antes de publicar el frontend en un dominio real.
ALLOWED_ORIGIN=

# Opcional. Sin esto, los datos se guardan en un archivo local (data/db.json) — cómodo para
# desarrollo, pero en plataformas de disco efímero (ej. Render free tier) se pierde en cada
# redeploy. Con una cadena de conexión de Postgres aquí (ej. de Neon o Supabase, gratis y sin
# vencimiento), los datos persisten entre redeploys. Ver backend/README.md, sección "Base de
# datos persistente".
DATABASE_URL=
