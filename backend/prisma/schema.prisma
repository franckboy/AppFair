// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Asset {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Estimated economic value of the asset, used as a reference for loss magnitude.
  value       Float?
  scenarios   RiskScenario[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Threat {
  id          String   @id @default(cuid())
  name        String
  description String?
  scenarios   RiskScenario[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A risk scenario pairs an asset with a threat and holds the FAIR inputs
// needed to run a Monte Carlo simulation: each parameter is a PERT
// distribution (min, most likely, max) rather than a single number,
// since these are expert estimates, not known quantities.
model RiskScenario {
  id       String @id @default(cuid())
  name     String
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id])
  threatId String
  threat   Threat @relation(fields: [threatId], references: [id])

  // Threat Event Frequency: how many times per year the threat acts against the asset.
  tefMin        Float
  tefMostLikely Float
  tefMax        Float

  // Vulnerability: probability (0-1) that a threat event becomes a loss event.
  vulnMin        Float
  vulnMostLikely Float
  vulnMax        Float

  // Loss Magnitude: broken into named categories (productivity, response costs,
  // reputational damage, ...) rather than one aggregate figure — a single loss
  // event typically triggers costs across several of them at once, and expressing
  // them separately is what a sensitivity analysis can attribute variance to.
  lossCategories LossCategory[]

  treatments Treatment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([threatId])
}

// One loss-magnitude category for a RiskScenario (a PERT estimate on its own).
// `key` is one of the fixed set in fair/lossCategories.ts (e.g. "productividad"),
// enforced at the API layer, not by a DB enum, so new categories don't need a migration.
model LossCategory {
  id             String       @id @default(cuid())
  riskScenarioId String
  riskScenario   RiskScenario @relation(fields: [riskScenarioId], references: [id], onDelete: Cascade)
  key            String
  min            Float
  mostLikely     Float
  max            Float

  @@unique([riskScenarioId, key])
  @@index([riskScenarioId])
}

enum TreatmentStrategy {
  MITIGATE
  TRANSFER
  AVOID
  ACCEPT
}

// A candidate response to a RiskScenario. Scenarios can hold several treatments
// side by side (e.g. a control vs. an insurance policy vs. doing nothing) so
// their ROSI can be compared before picking one.
model Treatment {
  id             String            @id @default(cuid())
  riskScenarioId String
  riskScenario   RiskScenario      @relation(fields: [riskScenarioId], references: [id], onDelete: Cascade)
  strategy       TreatmentStrategy
  name           String

  // Annualized cost of this treatment (0 for ACCEPT, which is the do-nothing baseline).
  annualCost Float

  // Meaning depends on strategy: for MITIGATE, the % reduction applied to the
  // scenario's vulnerability (fewer threat events become loss events); for
  // TRANSFER, the % of each loss event's magnitude covered by a third party
  // (e.g. insurance). Not applicable to AVOID (risk eliminated entirely) or
  // ACCEPT (unchanged).
  reductionPct Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riskScenarioId])
}
