{
  "name": "motor-riesgos-fair-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend de app_fair.html. Vite se usa como servidor de desarrollo y build local (Fase 1 del plan de migración) — producción sigue sirviendo el archivo fuente tal cual, sin build, ver README.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:css": "node scripts/build-css.js",
